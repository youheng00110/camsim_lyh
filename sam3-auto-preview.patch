+                            f"video={video_id}, frame={time_index}"
+                        )
+
+                    for view_index, view in enumerate(views):
+                        if not isinstance(view, dict):
+                            raise TypeError(
+                                f"Each view must be an object in {manifest_path}, "
+                                f"video={video_id}, frame={time_index}"
