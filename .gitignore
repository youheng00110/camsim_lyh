# 忽略克隆的 OpenDWM 仓库（整目录忽略）

*.png

# 忽略 waymo_link 符号链接（无论指向文件还是目录）
/waymo_link
/gpu_check_logs
#忽略pkl文件
*.pkl
*.png
nuplan_cache/          
!utils/valid.pkl  
# keep these four png files
!/image-1.png
!/image-2.png
!/image-3.png
!/image-4.png
# 只忽略特定目录下的大 json 文件（示例，根据你的实际路径改）
nuscenes_val_sort/*.json
waymo_prepo/*.json
avrgo2_json/*.json
nuplan-devkit-master/
mini_sensors/
# 先声明要保留 preview 和 log（Git 会优先处理这些）
!output/*/preview/
!output/*/preview/**
!output/*/log/
!output/*/log/**
*.pth
# 再忽略其他所有 output 目录
# 上面的 output/*/ 只会忽略一级子目录，不会匹配 output/ 本身，也不会影响已经被 ! 保留的路径

# 额外保险：强制忽略大文件/模型，即使在 preview/log 里也不上传
output/**/*.pth
output/**/*.pt
output/**/*.ckpt
output/**/*.pkl
output/**/*.bin
output/**/*.safetensors
output/**/*.zip
output/**/*.tar
output/**/*.gz

# 强制忽略 checkpoints 和 optimizer（绝对不上传）
output/**/checkpoints/
output/**/optimizer/
# training outputs
output/
*.pth
*.pt
*.ckpt
*.mp4
events.out.tfevents.*
__pycache__/

# large local models / migrated weights
/lyhmigration/
/lyhimigration/

# large nuScenes 12Hz data
/interp_12Hz_trainval/
/nusc12hz/

# archives / weights
/transport
/lyhdwm.tar.gz
*.safetensors
*.pth
*.pt
*.ckpt
*.tar.gz

# training outputs
/output/
*.mp4
events.out.tfevents.*

# python cache
__pycache__/
*.pyc
.cache/
