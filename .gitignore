# 忽略克隆的 OpenDWM 仓库（整目录忽略）


# 忽略 waymo_link 符号链接（无论指向文件还是目录）
/waymo_link
#忽略pkl文件
*.pkl          
!utils/valid.pkl  
# 只忽略特定目录下的大 json 文件（示例，根据你的实际路径改）
waymo_balanced/*.json
waymo_caption_v2/*.json
nuscenes_train_balanced/*.json
nuscenes_val_sort/*.json
waymo_prepo/*.json
avrgo2_json/*.json
nuplan-devkit-master/
mini_sensors/
# 1. 先忽略整个 output 目录（作为基础）
output/

# 2. 强制保留你要的 preview 和 log（! 表示不忽略）
!output/*/preview/
!output/*/preview/**
!output/*/log/
!output/*/log/**

# 3. 强制忽略大文件（即使在 preview/log 里也忽略，防止卡）
output/**/*.pth
output/**/*.pt
output/**/*.ckpt
output/**/*.pkl
output/**/*.zip
output/**/*.tar
output/**/*.gz

# 4. 强制忽略 checkpoints 和 optimizer（绝对不上传）
output/**/checkpoints/
output/**/optimizer/
EOF